{
 "what": "file-level comparison of the ryeong search library against search-core",
 "reference_commit": "7008304b2c14136cba333840368dae35e925a885",
 "summary": {
  "identical": 13,
  "differ": 12,
  "reference_only": [
   "HuggingFaceTokenizer.java",
   "InMemoryKeywordCandidateSource.java",
   "KeywordCandidateSource.java",
   "LightweightTokenizer.java",
   "NoOpRerankerEngine.java",
   "RerankerEngine.java",
   "RoomFtsKeywordRetriever.java",
   "SearchExample.java",
   "SearchMode.java",
   "SqliteFts5KeywordRetriever.java",
   "TextTokenizer.java"
  ],
  "current_only": []
 },
 "finding": "search-core is already a port of this library - same package, 13 files byte-identical. Every file present on both sides is LARGER in search-core, i.e. current is the reference plus later hardening.",
 "ported_in_this_pass": [],
 "not_ported_and_why": [
  {
   "item": "QueryAnalyzer normalisation",
   "decision": "not ported",
   "reason": "the reference analyzer only lowercases and splits. search-core additionally strips Korean particles and honorifics (에게/한테/씨/님/을/를/…) and stop words, so \"김서준씨\" and \"김서준한테\" already resolve to the person. Porting the reference version would remove that."
  },
  {
   "item": "SqliteFts5KeywordRetriever / RoomFtsKeywordRetriever",
   "decision": "not ported",
   "reason": "the reference retrievers perform no FTS escaping at all. The current Room path strips every non-alphanumeric character and filters FTS operators before MATCH, which is stronger than escaping - it removes the syntax rather than quoting it."
  },
  {
   "item": "RerankerEngine / NoOpRerankerEngine",
   "decision": "not ported",
   "reason": "a seam with no implementation behind it on the reference side either; adding an unused abstraction is not hardening."
  },
  {
   "item": "TextTokenizer / LightweightTokenizer / HuggingFaceTokenizer",
   "decision": "not ported",
   "reason": "tokenisation here is QueryAnalyzer's job and it is the stronger of the two. HuggingFaceTokenizer additionally implies a model dependency the JVM path does not have."
  },
  {
   "item": "KeywordCandidateSource / InMemoryKeywordCandidateSource",
   "decision": "not ported",
   "reason": "search-core already injects Room candidates through the retrieve(..., indexedKeywordResults) parameter, which is the same seam by another name."
  },
  {
   "item": "SearchMode enum",
   "decision": "not ported",
   "reason": "RetrievalMode already covers HYBRID / KEYWORD_ONLY / SEMANTIC_ONLY."
  },
  {
   "item": "SearchExample",
   "decision": "not ported",
   "reason": "sample code, not production."
  }
 ],
 "defect_found_and_fixed": {
  "what": "an agent lookup whose query analysed to no usable terms returned the entire roster",
  "how": "LikeFallbackKeywordRetriever had `if (tokens.isEmpty() || matches > 0)`, and the same instance served both the card-tab browse view and the agent lookup. \"명함 찾아줘\" is entirely stop words, so it analysed to zero tokens and matched every card. With a single-card store that becomes a SINGLE_RESULT selection - an actionable target from a query that matched nothing.",
  "fix": "LikeFallbackKeywordRetriever.EmptyQueryPolicy: the card tab keeps MATCH_ALL (an empty box means show everyone), the agent path uses MATCH_NONE.",
  "evidence": "characterization/{red,green}/search_contract.log"
 },
